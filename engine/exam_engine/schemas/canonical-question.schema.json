{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exam-paper-synthesis/schemas/canonical-question.schema.json",
  "title": "Canonical Question Object",
  "description": "The single source of truth for one question (generated or sourced). Rendered worksheet/answer-key/diagram are views of this object. See docs/SCHEMA.md and ADR-0004/0012/0013/0014.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "source_type", "syllabus", "cognitive", "question", "provenance"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver of this schema; validated on load."
    },
    "id": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["generated", "sourced"],
      "description": "generated = from a blueprint+solver; sourced = ingested externally."
    },
    "blueprint_code": {
      "type": ["string", "null"],
      "description": "Required for generated questions; null for sourced."
    },
    "seed": { "type": ["integer", "null"] },
    "syllabus": { "$ref": "#/$defs/syllabus" },
    "cognitive": { "$ref": "#/$defs/cognitive" },
    "parameters": {
      "type": ["object", "null"],
      "description": "Sampled inputs for generated questions; must validate against the blueprint's declared parameter schema (ADR-0014). Null for sourced."
    },
    "question": { "$ref": "#/$defs/question" },
    "source": { "$ref": "#/$defs/source" },
    "license": { "type": ["string", "null"] },
    "validation": { "$ref": "#/$defs/validation" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "$comment": "Generated questions must name a blueprint and parameters.",
      "if": { "properties": { "source_type": { "const": "generated" } } },
      "then": { "required": ["blueprint_code", "parameters"], "properties": {
        "blueprint_code": { "type": "string" },
        "parameters": { "type": "object" }
      } }
    },
    {
      "$comment": "Sourced questions must carry provenance source + license.",
      "if": { "properties": { "source_type": { "const": "sourced" } } },
      "then": { "required": ["source", "license"], "properties": {
        "source": { "type": "object" },
        "license": { "type": "string" }
      } }
    }
  ],

  "$defs": {
    "syllabus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "strand", "topic", "skill_codes"],
      "properties": {
        "level": { "type": "string", "enum": ["P5", "P6"], "$comment": "MVP scope; extend for Sec/O-Level later." },
        "strand": { "type": "string" },
        "topic": { "type": "string" },
        "subtopic": { "type": ["string", "null"] },
        "skill_codes": { "type": "array", "items": { "type": "string" } }
      }
    },

    "cognitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["difficulty", "cognitive_level"],
      "properties": {
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "cognitive_level": {
          "type": "string",
          "enum": ["routine_procedural", "complex_familiar", "non_routine_heuristic"]
        },
        "heuristics": { "type": "array", "items": { "type": "string" } },
        "representations": { "type": "array", "items": { "type": "string" } },
        "difficulty_levers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Which difficulty levers this question employs (see docs/DIFFICULTY.md / ADR-0015)."
        }
      }
    },

    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parts", "total_marks"],
      "properties": {
        "stem": { "type": ["string", "null"], "description": "Optional shared lead-in for multi-part questions." },
        "diagram": {
          "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/diagram" } ],
          "description": "Optional stem-level figure shared by every part (added schema 1.5.0). Sibling to `stem`, rendered once before the parts loop. Distinct from a part's own `diagram`, which is part-scoped; both may coexist."
        },
        "table": {
          "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/table" } ],
          "description": "Optional content-level table (added schema 1.6.0, ADR-0020). Sibling to `stem`/`diagram`, rendered once before the parts loop; a cell may bind to a part's answer via `answer_for`."
        },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/part" } },
        "total_marks": { "type": "integer", "minimum": 0 }
      }
    },

    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "text", "answer", "solution_steps"],
      "properties": {
        "label": { "type": "string", "description": "e.g. 'a', 'b', 'c'. Use 'a' (or '') for single-part." },
        "text": { "type": "string", "minLength": 1 },
        "marks": { "type": "integer", "minimum": 0 },
        "answer": { "$ref": "#/$defs/answer" },
        "marking_scheme": { "type": "array", "items": { "$ref": "#/$defs/mark" } },
        "solution_steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "diagram": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/diagram" } ] }
      }
    },

    "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark", "type", "description"],
      "properties": {
        "mark": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "enum": ["M", "A", "B"], "description": "M=method, A=accuracy, B=independent." },
        "description": { "type": "string" }
      }
    },

    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "expr": { "type": ["string", "null"], "description": "Optional machine-checkable expression for verification." }
      }
    },

    "unit": {
      "type": "string",
      "$comment": "Controlled vocabulary (ADR-0013/0014). Extend deliberately.",
      "enum": ["", "cm", "m", "km", "mm", "cm^2", "m^2", "cm^3", "m^3", "ml", "l", "g", "kg", "$", "cents", "%", "degrees", "s", "min", "h", "km/h", "m/s", "m/min", "marbles", "items", "people", "units"]
    },

    "answer": {
      "description": "Discriminated union keyed by `type` (ADR-0013).",
      "oneOf": [
        { "$ref": "#/$defs/answer_integer" },
        { "$ref": "#/$defs/answer_decimal" },
        { "$ref": "#/$defs/answer_fraction" },
        { "$ref": "#/$defs/answer_ratio" },
        { "$ref": "#/$defs/answer_quantity" },
        { "$ref": "#/$defs/answer_set" },
        { "$ref": "#/$defs/answer_text" },
        { "$ref": "#/$defs/answer_choice" },
        { "$ref": "#/$defs/answer_construction" },
        { "$ref": "#/$defs/answer_expression" }
      ]
    },
    "table": {
      "type": "object", "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "caption": { "type": ["string", "null"] },
        "headers": { "type": ["array", "null"], "items": { "type": ["string", "number", "null"] } },
        "rows": {
          "type": "array", "minItems": 1,
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/table_cell" } }
        }
      }
    },
    "table_cell": {
      "$comment": "A plain value (null = genuinely empty cell), or {answer_for: part.label} marking the cell as that part's answer surface: blank on the worksheet, filled in the answer key. The label is not schema-enforced to exist (human review).",
      "oneOf": [
        { "type": ["string", "number", "null"] },
        {
          "type": "object", "additionalProperties": false,
          "required": ["answer_for"],
          "properties": { "answer_for": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "answer_construction": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "diagram"],
      "$comment": "Answer whose value is itself a figure (added schema 1.6.0, ADR-0020): the answer key draws the completed geometry_figure instead of printing a value.",
      "properties": {
        "type": { "const": "construction" },
        "diagram": { "$ref": "#/$defs/diagram_geometry_figure" }
      }
    },
    "answer_expression": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "terms"],
      "$comment": "Answer 'in terms of' a symbol (added schema 1.11.0, tier-2 slice T5): a collected sum of coefficient*symbol^power terms, symbol null = constant, e.g. (42π + 84) m or $17n. One symbol per term (no πr²). Collected form and term order are enforced at load by exam_engine.expression.check_expression_consistency.",
      "properties": {
        "type": { "const": "expression" },
        "terms": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["coefficient"],
            "properties": {
              "coefficient": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
              "symbol": { "type": ["string", "null"], "pattern": "^(π|[A-Za-z])(?![\\s\\S])" },
              "power": { "type": "integer", "minimum": 1, "maximum": 4, "default": 1 }
            }
          }
        },
        "unit": { "$ref": "#/$defs/unit" }
      }
    },
    "answer_integer": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "integer" },
        "value": { "type": "integer" },
        "unit": { "$ref": "#/$defs/unit" }
      }
    },
    "answer_decimal": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "decimal" },
        "value": { "type": "number" },
        "dp": { "type": ["integer", "null"], "minimum": 0, "description": "Required decimal places, if constrained." },
        "unit": { "$ref": "#/$defs/unit" }
      }
    },
    "answer_fraction": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "numerator", "denominator"],
      "properties": {
        "type": { "const": "fraction" },
        "numerator": { "type": "integer" },
        "denominator": { "type": "integer", "not": { "const": 0 } },
        "mixed": { "type": "boolean", "default": false },
        "unit": { "$ref": "#/$defs/unit" }
      }
    },
    "answer_ratio": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "parts"],
      "properties": {
        "type": { "const": "ratio" },
        "parts": { "type": "array", "minItems": 2, "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "answer_quantity": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value", "unit"],
      "properties": {
        "type": { "const": "quantity" },
        "value": { "type": "number" },
        "unit": { "$ref": "#/$defs/unit" }
      }
    },
    "answer_set": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "values"],
      "properties": {
        "type": { "const": "set" },
        "values": { "type": "array", "minItems": 1, "items": { "type": ["number", "string"] } },
        "ordered": { "type": "boolean", "default": false }
      }
    },
    "answer_text": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" }
      }
    },
    "answer_choice": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "options", "correct"],
      "$comment": "MCQ answer (added schema 1.5.0, ADR-0020). Options are question content — the worksheet shows all of them; only `correct` is secret.",
      "properties": {
        "type": { "const": "choice" },
        "options": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "text": { "type": ["string", "null"] },
              "diagram": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/diagram" } ] }
            }
          }
        },
        "correct": { "type": "string", "minLength": 1 }
      }
    },

    "diagram": {
      "description": "Discriminated union keyed by `type` (ADR-0012).",
      "oneOf": [
        { "$ref": "#/$defs/diagram_bar_model" },
        { "$ref": "#/$defs/diagram_bar_model_before_after" },
        { "$ref": "#/$defs/diagram_geometry_figure" },
        { "$ref": "#/$defs/diagram_shaded_fraction" },
        { "$ref": "#/$defs/diagram_raster" },
        { "$ref": "#/$defs/diagram_chart" },
        { "$ref": "#/$defs/diagram_solid" },
        { "$ref": "#/$defs/diagram_number_line" },
        { "$ref": "#/$defs/diagram_panels" }
      ]
    },
    "diagram_bar_model": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "bars"],
      "properties": {
        "type": { "const": "bar_model" },
        "bars": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["label", "units"],
            "properties": {
              "label": { "type": "string" },
              "units": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "from_unit": { "type": "integer", "minimum": 0 },
              "to_unit": { "type": "integer", "minimum": 0 },
              "label": { "type": "string" }
            }
          }
        },
        "total_bracket": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["label"],
          "properties": { "label": { "type": "string" } },
          "$comment": "Vertical curly brace spanning all bars, labelling the total (added in schema 1.1.0)."
        }
      }
    },
    "diagram_bar_model_before_after": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "stages"],
      "$comment": "Before-after ratio aid: two stages of bars sharing a unit scale (added in schema 1.2.0). The optional per-bar `parts` (original ratio-term count that a bar's equalised `units` represent) and `view_mode` (grouped|sliced) drive the two KAN-310 render modes; both are additive and arrived in schema 1.4.0 (alongside the geometry segment `dashed` field). Coprime-ish ratios blow up the common-unit LCM, so `view_mode` defaults to \"grouped\": bars drawn at original-ratio granularity with a per-segment unit-worth label (never explodes). \"sliced\" keeps the common-unit grid with heavy dividers on the original-ratio boundaries. `parts` is display-only (the answer is unchanged); the consistency check verifies it against the ratio terms when present.",
      "properties": {
        "type": { "const": "bar_model_before_after" },
        "view_mode": {
          "enum": ["grouped", "sliced"],
          "default": "grouped",
          "$comment": "Render mode (KAN-310, schema 1.4.0). Default \"grouped\"."
        },
        "stages": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "bars"],
            "properties": {
              "name": { "type": "string" },
              "bars": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["label", "units"],
                  "properties": {
                    "label": { "type": "string" },
                    "units": { "type": "integer", "minimum": 0 },
                    "parts": {
                      "type": "integer", "minimum": 1,
                      "$comment": "Original ratio-term count this bar's `units` represent (KAN-310, schema 1.4.0). Each drawn segment is worth `units / parts` common units."
                    }
                  }
                }
              }
            }
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "from_unit": { "type": "integer", "minimum": 0 },
              "to_unit": { "type": "integer", "minimum": 0 },
              "label": { "type": "string" }
            }
          }
        },
        "total_bracket": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["label"],
          "properties": { "label": { "type": "string" } },
          "$comment": "Vertical curly brace on the invariant person's bar, labelling their amount."
        }
      }
    },
    "diagram_geometry_figure": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "unit", "points"],
      "$comment": "General 2D figure (added in schema 1.3.0). Covers both PSLE geometry families: angle figures (points + segments + angle marks) and area/perimeter figures (+ arcs + shaded regions + dimension labels). Supersedes the never-built composite_geometry + area_perimeter types. Coordinates are figure-space floats scaled into a fixed viewBox by the renderer; labelled values are exact (from params, never measured off the drawing). See docs/shaping/V6b-geometry-plan.md.",
      "properties": {
        "type": { "const": "geometry_figure" },
        "unit": { "$ref": "#/$defs/unit", "$comment": "For length/area labels; angles are unitless degrees." },
        "points": {
          "type": "array", "minItems": 0,
          "description": "Named vertices in figure coordinates. May be empty for a grid-only figure (e.g. a net drawn purely with `polygons`; schema 1.6.0).",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "x", "y"],
            "properties": {
              "id": { "type": "string" },
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        },
        "segments": {
          "type": "array",
          "description": "Straight edges between named points; optional length label and equal-side tick marks.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "label": { "type": ["string", "null"] },
              "ticks": { "type": "integer", "minimum": 0 },
              "dashed": { "type": "boolean", "default": false }
            }
          }
        },
        "arcs": {
          "type": "array",
          "description": "Circular arcs (whole/semi/quarter circles) centred on a named point.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["center", "radius", "start_deg", "end_deg"],
            "properties": {
              "center": { "type": "string" },
              "radius": { "type": "number", "exclusiveMinimum": 0 },
              "start_deg": { "type": "number" },
              "end_deg": { "type": "number" },
              "label": { "type": ["string", "null"] }
            }
          }
        },
        "angles": {
          "type": "array",
          "description": "Angle marks at a named vertex, swept from one ray to another. Exactly one may be the unknown to solve.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["at", "from", "to"],
            "properties": {
              "at": { "type": "string" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "value_deg": { "type": ["number", "null"] },
              "unknown": { "type": "boolean", "default": false },
              "right": { "type": "boolean", "default": false },
              "part_label": {
                "type": ["string", "null"],
                "description": "Which part.label this unknown answers, when the figure is stem-level and serves more than one part (added schema 1.5.0). Null/absent when the figure is part-scoped or has a single unknown (today's default)."
              }
            }
          }
        },
        "shaded": {
          "type": ["array", "null"],
          "description": "Region(s) to fill, each a boundary of named points optionally closed by arcs.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["boundary"],
            "properties": {
              "boundary": { "type": "array", "minItems": 3, "items": { "type": "string" } },
              "arcs": { "type": "array" }
            }
          }
        },
        "grid": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["cell_size", "cols", "rows"],
          "description": "Square-grid backdrop (added schema 1.6.0): coordinate grids, nets, rod patterns, construction canvases.",
          "properties": {
            "cell_size": { "type": "number", "exclusiveMinimum": 0 },
            "cols": { "type": "integer", "minimum": 1 },
            "rows": { "type": "integer", "minimum": 1 },
            "origin": {
              "type": ["object", "null"], "additionalProperties": false,
              "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
              "description": "Figure-space coordinate of the grid's top-left corner; defaults to (0, 0)."
            },
            "show_axes": { "type": "boolean", "default": false, "description": "Numbered x/y labels along the grid edges." }
          }
        },
        "polygons": {
          "type": "array",
          "description": "Grid-cell regions (schema 1.6.0); each cell is drawn as its own bordered unit square. Requires `grid`.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["cells"],
            "properties": {
              "cells": {
                "type": "array", "minItems": 1,
                "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } },
                "description": "[col, row] 0-indexed grid cells."
              },
              "fill": { "type": "boolean", "default": false },
              "label": { "type": ["string", "null"] }
            }
          }
        },
        "labels": {
          "type": "array",
          "description": "Free text labels anchored at a named point.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["at", "text"],
            "properties": {
              "at": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "diagram_shaded_fraction": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "total_parts", "shaded_parts", "shape"],
      "properties": {
        "type": { "const": "shaded_fraction" },
        "shape": { "type": "string", "enum": ["rectangle", "circle", "bar"] },
        "total_parts": { "type": "integer", "minimum": 1 },
        "shaded_parts": { "type": "integer", "minimum": 0 }
      }
    },
    "diagram_chart": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "kind"],
      "$comment": "Statistical chart (added schema 1.7.0, tier-2 slice T1; docs/planning/editor/TIER2-SHAPING.md). The data is the figure: the renderer derives the drawing from it. `show_value: false` draws a sector at its true size but never prints its number. Cross-field consistency (series align with categories, values lie on the axis, step divides the span, a percent pie sums to 100) is enforced at load by exam_engine.chart.check_chart_consistency, not by this schema.",
      "properties": {
        "type": { "const": "chart" },
        "kind": { "enum": ["bar", "line", "pie"] },
        "title": { "type": ["string", "null"] },
        "x_axis": {
          "type": "object", "additionalProperties": false, "required": ["categories"],
          "properties": {
            "title": { "type": ["string", "null"] },
            "categories": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "y_axis": {
          "type": "object", "additionalProperties": false, "required": ["min", "max", "step"],
          "properties": {
            "title": { "type": ["string", "null"] },
            "unit": { "type": ["string", "null"] },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "series": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "values"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "values": { "type": "array", "items": { "type": ["number", "null"] }, "description": "One entry per x_axis category; null = no bar/point." },
              "show_values": { "type": "boolean", "default": false }
            }
          }
        },
        "sectors": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "number", "exclusiveMinimum": 0 },
              "show_value": { "type": "boolean", "default": true }
            }
          }
        },
        "value_unit": { "type": ["string", "null"], "description": "Pie only, e.g. \"%\"; a \"%\" pie must sum to 100." }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "pie" } } },
          "then": { "required": ["sectors"], "not": { "anyOf": [ { "required": ["x_axis"] }, { "required": ["y_axis"] }, { "required": ["series"] } ] } },
          "else": { "required": ["x_axis", "y_axis", "series"], "not": { "anyOf": [ { "required": ["sectors"] }, { "required": ["value_unit"] } ] } }
        }
      ]
    },
    "diagram_solid": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "kind", "dims"],
      "$comment": "Cuboid or open-top container with an optional fill level (added schema 1.8.0, tier-2 slice T2; docs/planning/editor/TIER2-SHAPING.md). Fixed oblique projection, dashed hidden edges. A dimension named in `hidden_dims` (or a fill with `show_height: false`) is drawn true to scale but printed as '?'. Cross-field consistency (fill within height, fill only on a container, exact printing) is enforced at load by exam_engine.solid.check_solid_consistency, not by this schema.",
      "properties": {
        "type": { "const": "solid" },
        "kind": { "enum": ["cuboid", "container"] },
        "title": { "type": ["string", "null"] },
        "dims": {
          "type": "object", "additionalProperties": false, "required": ["length", "width", "height"],
          "properties": {
            "length": { "type": "number", "minimum": 0.001, "maximum": 1000000 },
            "width": { "type": "number", "minimum": 0.001, "maximum": 1000000 },
            "height": { "type": "number", "minimum": 0.001, "maximum": 1000000 }
          }
        },
        "unit": { "type": ["string", "null"], "description": "e.g. \"cm\"." },
        "hidden_dims": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["length", "width", "height"] }
        },
        "fill": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["height"],
          "description": "Contents depth (container only); 0 <= height <= dims.height.",
          "properties": {
            "height": { "type": "number", "minimum": 0, "maximum": 1000000 },
            "show_height": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "diagram_number_line": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "start", "end", "divisions"],
      "$comment": "Number line (added schema 1.9.0, tier-2 slice T3; docs/planning/editor/TIER2-SHAPING.md). `divisions` equal intervals from start to end; tick labels print only at the indices in `labelled`; `marked_points` are lettered arrows the student reads. Cross-field consistency (marked points on a tick and never on a labelled tick unless `known`) is enforced at load by exam_engine.number_line.check_number_line_consistency, not by this schema.",
      "properties": {
        "type": { "const": "number_line" },
        "title": { "type": ["string", "null"] },
        "start": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "end": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "divisions": { "type": "integer", "minimum": 1, "maximum": 100 },
        "label_style": { "enum": ["decimal", "fraction"], "default": "decimal" },
        "labelled": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 },
          "description": "Tick indices (0..divisions) whose value is printed."
        },
        "marked_points": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["at", "label"],
            "properties": {
              "at": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
              "label": { "type": "string", "minLength": 1 },
              "known": { "type": "boolean", "default": false, "description": "True when the point's value is given, so it may sit on a labelled tick." }
            }
          }
        }
      }
    },
    "diagram_panels": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "panels"],
      "$comment": "Two to four figures side by side with an arrow between each pair, e.g. before/after (added schema 1.10.0, tier-2 slice T4). Each panel holds any vector diagram (schema: diagram_vector, so no nesting and no raster); exam_engine.diagram.check_panels_consistency runs each panel's own consistency check at load.",
      "properties": {
        "type": { "const": "panels" },
        "title": { "type": ["string", "null"] },
        "arrows": { "type": "boolean", "default": true },
        "panels": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["figure"],
            "properties": {
              "title": { "type": ["string", "null"], "maxLength": 40 },
              "figure": { "$ref": "#/$defs/diagram_vector" }
            }
          }
        }
      }
    },
    "diagram_vector": {
      "$comment": "Any diagram that renders as an <svg>: the union minus `raster` and `panels` (so panels cannot nest and validation depth stays bounded).",
      "oneOf": [
        { "$ref": "#/$defs/diagram_bar_model" },
        { "$ref": "#/$defs/diagram_bar_model_before_after" },
        { "$ref": "#/$defs/diagram_geometry_figure" },
        { "$ref": "#/$defs/diagram_shaded_fraction" },
        { "$ref": "#/$defs/diagram_chart" },
        { "$ref": "#/$defs/diagram_solid" },
        { "$ref": "#/$defs/diagram_number_line" }
      ]
    },
    "diagram_raster": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "asset_ref", "alt_text"],
      "properties": {
        "type": { "const": "raster" },
        "asset_ref": { "type": "string", "description": "Path/URI to the image (sourced diagrams)." },
        "alt_text": { "type": "string" }
      }
    },

    "source": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Citation for sourced questions.",
      "properties": {
        "origin": { "type": "string", "description": "e.g. school name, assessment book title." },
        "year": { "type": ["integer", "null"] },
        "paper": { "type": ["string", "null"] },
        "reference": { "type": ["string", "null"] }
      }
    },

    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail", "unverified"] },
        "checks": {
          "type": "object",
          "description": "Per-check booleans/notes, e.g. answer_verified, unique, diagram_consistent, within_level.",
          "additionalProperties": { "type": ["boolean", "string", "null"] }
        }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by", "version"],
      "properties": {
        "created_by": { "type": "string", "enum": ["engine", "ingested"] },
        "llm_used": { "type": "boolean", "default": false },
        "created_at": { "type": ["string", "null"], "description": "ISO-8601 timestamp; nullable." },
        "parent_id": { "type": ["string", "null"], "description": "Lineage: the object this was edited from." },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
