{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exam-paper-synthesis/schemas/document.schema.json",
  "title": "Document (WYSIWYG paper)",
  "description": "A paper as ProseMirror-style JSON (ADR-0021). Only the node types below are allowed; a new node type is an explicit schema_version bump, never silent drift. Embedded questions are validated against the canonical question schema by exam_engine.document.validate_document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "content"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string", "maxLength": 200 },
    "content": { "$ref": "#/$defs/doc" }
  },
  "$defs": {
    "doc": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "doc" },
        "content": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/bullet_list" },
        { "$ref": "#/$defs/ordered_list" },
        { "$ref": "#/$defs/page_break" },
        { "$ref": "#/$defs/templated_question" }
      ]
    },
    "heading": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "heading" },
        "attrs": {
          "type": "object", "additionalProperties": false,
          "required": ["level"],
          "properties": { "level": { "type": "integer", "minimum": 1, "maximum": 3 } }
        },
        "content": { "type": "array", "items": { "$ref": "#/$defs/inline" } }
      }
    },
    "paragraph": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "paragraph" },
        "content": { "type": "array", "items": { "$ref": "#/$defs/inline" } }
      }
    },
    "bullet_list": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "bulletList" },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/list_item" } }
      }
    },
    "ordered_list": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "orderedList" },
        "attrs": {
          "type": "object", "additionalProperties": false,
          "properties": { "start": { "type": "integer", "minimum": 1 } }
        },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/list_item" } }
      }
    },
    "list_item": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "listItem" },
        "content": {
          "type": "array", "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/paragraph" },
              { "$ref": "#/$defs/bullet_list" },
              { "$ref": "#/$defs/ordered_list" }
            ]
          }
        }
      }
    },
    "inline": {
      "oneOf": [ { "$ref": "#/$defs/text" }, { "$ref": "#/$defs/hard_break" } ]
    },
    "text": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "marks": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["type"],
            "properties": { "type": { "enum": ["bold", "italic", "underline"] } }
          }
        }
      }
    },
    "hard_break": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "hardBreak" } }
    },
    "page_break": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "pageBreak" } }
    },
    "templated_question": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "templatedQuestion" },
        "attrs": {
          "type": "object", "additionalProperties": false,
          "required": ["block_id", "question"],
          "properties": {
            "block_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,64}$" },
            "question": { "type": "object", "description": "Frozen snapshot of a canonical question object (validated by the canonical schema)." }
          }
        }
      }
    }
  }
}
