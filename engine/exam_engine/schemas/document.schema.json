{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exam-paper-synthesis/schemas/document.schema.json",
  "title": "Document (WYSIWYG paper)",
  "description": "A paper as ProseMirror-style JSON (ADR-0021). Only the node types below are allowed; a new node type is an explicit schema_version bump, never silent drift. Embedded questions are validated against the canonical question schema by exam_engine.document.validate_document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "content"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string", "maxLength": 200 },
    "content": { "$ref": "#/$defs/doc" },
    "settings": { "$ref": "#/$defs/settings" }
  },
  "$defs": {
    "settings": {
      "type": "object", "additionalProperties": false,
      "$comment": "Per-question `space_mm` (blank working space, mm; null = default for its marks) and `ans_unit` (unit printed after the Ans: line; null = from the answer) were added with this. Paper-wide print settings (added 1.4.0). marks_placement: where each question's [n] prints; default 'answer' (beside the Ans: line).",
      "properties": {
        "marks_placement": { "enum": ["question", "answer", "both"], "default": "answer" },
        "key_options": {
          "type": "object", "additionalProperties": false,
          "description": "How the answer key prints (1.7.0, P5). Both default to true, i.e. the pre-P5 key.",
          "properties": {
            "show_question": { "type": "boolean", "description": "Repeat each question's text, figure and options above its answer; false = steps and answer only." },
            "show_scheme": { "type": "boolean", "description": "Print the M/A/B marking breakdown under each answer." }
          }
        },
        "time_min": { "type": ["integer", "null"], "minimum": 1, "maximum": 600, "description": "Paper time in minutes (1.6.0); printed in the paper header." }
      }
    },
    "doc": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "doc" },
        "content": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/bullet_list" },
        { "$ref": "#/$defs/ordered_list" },
        { "$ref": "#/$defs/page_break" },
        { "$ref": "#/$defs/section" },
        { "$ref": "#/$defs/templated_question" },
        { "$ref": "#/$defs/freeform_question" },
        { "$ref": "#/$defs/image" }
      ]
    },
    "text_block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/bullet_list" },
        { "$ref": "#/$defs/ordered_list" },
        { "$ref": "#/$defs/image" }
      ]
    },
    "heading": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "heading" },
        "attrs": {
          "type": "object", "additionalProperties": false,
          "required": ["level"],
          "properties": { "level": { "type": "integer", "minimum": 1, "maximum": 3 } }
        },
        "content": { "type": "array", "items": { "$ref": "#/$defs/inline" } }
      }
    },
    "paragraph": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "paragraph" },
        "content": { "type": "array", "items": { "$ref": "#/$defs/inline" } }
      }
    },
    "bullet_list": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "bulletList" },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/list_item" } }
      }
    },
    "ordered_list": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "orderedList" },
        "attrs": {
          "type": "object", "additionalProperties": false,
          "properties": { "start": { "type": "integer", "minimum": 1 } }
        },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/list_item" } }
      }
    },
    "list_item": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "listItem" },
        "content": {
          "type": "array", "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/paragraph" },
              { "$ref": "#/$defs/bullet_list" },
              { "$ref": "#/$defs/ordered_list" }
            ]
          }
        }
      }
    },
    "inline": {
      "oneOf": [ { "$ref": "#/$defs/text" }, { "$ref": "#/$defs/hard_break" }, { "$ref": "#/$defs/math" } ]
    },
    "math": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "math" },
        "attrs": {
          "type": "object", "additionalProperties": false,
          "required": ["latex"],
          "properties": { "latex": { "type": "string", "minLength": 1, "maxLength": 500 } }
        }
      }
    },
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "image" },
        "attrs": {
          "type": "object", "additionalProperties": false,
          "required": ["asset_id"],
          "properties": {
            "asset_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
            "alt": { "type": ["string", "null"], "maxLength": 300 },
            "width_pct": { "type": "integer", "minimum": 10, "maximum": 100 }
          }
        }
      }
    },
    "text": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "marks": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["type"],
            "properties": { "type": { "enum": ["bold", "italic", "underline"] } }
          }
        }
      }
    },
    "hard_break": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "hardBreak" } }
    },
    "page_break": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "pageBreak" } }
    },
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "attrs"],
      "$comment": "A paper section divider (1.6.0, P4): every question after it, up to the next section, belongs to it. Question numbers continue across sections; the section's question range and marks are derived (exam_engine.document.paper_outline), only the target is authored.",
      "properties": {
        "type": { "const": "section" },
        "attrs": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "maxLength": 120 },
            "instructions": { "type": ["string", "null"], "maxLength": 1000 },
            "mode": { "enum": ["mcq", "short", "structured", null] },
            "marks_target": { "type": ["integer", "null"], "minimum": 0, "maximum": 500 },
            "marking": { "type": ["boolean", "null"], "description": "Marking margin (\"Do not write in this space\") beside this section's questions (1.8.0, P6a). null/absent = on for working sections (short, structured), off otherwise." }
          }
        }
      }
    },
    "templated_question": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "templatedQuestion" },
        "attrs": {
          "type": "object", "additionalProperties": false,
          "required": ["block_id", "question"],
          "properties": {
            "block_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,64}$" },
            "question": { "type": "object", "description": "Frozen snapshot of a canonical question object (validated by the canonical schema)." },
            "space_mm": { "type": ["integer", "null"], "minimum": 0, "maximum": 250 },
            "ans_unit": { "type": ["string", "null"], "maxLength": 12 },
            "in_key": { "type": "boolean", "description": "false leaves this question out of the answer key (1.7.0); absent = included." },
            "remark": { "$ref": "#/$defs/remark" }
          }
        }
      }
    },
    "freeform_question": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "freeformQuestion" },
        "attrs": {
          "type": "object", "additionalProperties": false,
          "required": ["block_id"],
          "properties": {
            "block_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,64}$" },
            "marks": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
            "space_mm": { "type": ["integer", "null"], "minimum": 0, "maximum": 250 },
            "ans_unit": { "type": ["string", "null"], "maxLength": 12 },
            "answer": { "$ref": "#/$defs/answer_doc" },
            "in_key": { "type": "boolean", "description": "false leaves this question out of the answer key (1.7.0); absent = included." },
            "remark": { "$ref": "#/$defs/remark" }
          }
        },
        "content": {
          "type": "array", "minItems": 1,
          "$comment": "The body (text blocks), then optionally the parts (a), (b)... (added 1.5.0). Parts come last and at most 10; with parts, the marks live on the parts and the question-level marks/answer are unused. Order and limits are enforced by exam_engine.document.validate_document.",
          "items": { "oneOf": [ { "$ref": "#/$defs/text_block" }, { "$ref": "#/$defs/freeform_part" } ] }
        }
      }
    },
    "freeform_part": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "$comment": "One lettered part of a multi-part free-form question. The label (a), (b)... is its position, never stored.",
      "properties": {
        "type": { "const": "freeformPart" },
        "attrs": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "marks": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
            "space_mm": { "type": ["integer", "null"], "minimum": 0, "maximum": 250 },
            "ans_unit": { "type": ["string", "null"], "maxLength": 12 },
            "answer": { "$ref": "#/$defs/answer_doc" }
          }
        },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text_block" } }
      }
    },
    "remark": { "type": "string", "maxLength": 2000, "description": "The author's private note on a question (1.3.0). Shown in the inspector only; never rendered into any preview or export." },
    "answer_doc": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "doc" },
        "content": { "type": "array", "items": { "$ref": "#/$defs/text_block" } }
      }
    }
  }
}
