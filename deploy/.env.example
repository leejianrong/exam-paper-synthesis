# Copy to deploy/.env on the droplet (chmod 600) and fill in. Never commit the filled-in file.
# The app refuses to start in production on an unsafe value and names each problem in its log.

# The hostname Caddy serves and gets a certificate for. Until a domain is bought, use the
# droplet's IPv4 address with sslip.io: 203.0.113.10 → 203.0.113.10.sslip.io (its certificate
# may come from ZeroSSL: sslip.io shares Let's Encrypt's weekly limit with all its users).
SITE_ADDRESS=203.0.113.10.sslip.io
EXAM_PUBLIC_URL=https://203.0.113.10.sslip.io
EXAM_WEB_URL=https://203.0.113.10.sslip.io

# Which image to run. Every merge to main publishes :latest and :sha-<full commit sha>
# (.github/workflows/image.yml); pin a sha tag to roll back. The package is public, so no login.
APP_IMAGE=ghcr.io/leejianrong/exam-paper-synthesis
APP_TAG=latest

# Database password; letters and digits only, since it goes into a URL (@ / : break it):
#   openssl rand -hex 24
# Set it before the first start: Postgres keeps the password it was created with, so changing
# it here later does nothing to an existing volume.
POSTGRES_PASSWORD=

# Nightly database backups to a DigitalOcean Spaces bucket (docs/deploy/BACKUPS.md). Create the
# bucket in SGP1 (private, no CDN, versioning off) with a 14-day expiry rule, and a Spaces access
# key limited to that bucket (read, write and delete: the job deletes dumps older than 14 days,
# as the privacy notice promises). The backup job refuses to start while these are empty.
SPACES_BUCKET=
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
# Folder in the bucket and the daily time (Singapore, HH:MM).
BACKUP_PATH=db
BACKUP_TIME=03:00

# Sign-in (docs/AUTH.md). Callback URLs: https://<SITE_ADDRESS>/auth/<provider>/callback
EXAM_OAUTH_GOOGLE_CLIENT_ID=
EXAM_OAUTH_GOOGLE_CLIENT_SECRET=
EXAM_OAUTH_GITHUB_CLIENT_ID=
EXAM_OAUTH_GITHUB_CLIENT_SECRET=

# The contact address printed on /privacy and /terms (EXA-185). Until it is set the pages say
# one will be published before the service opens to the public.
EXAM_CONTACT_EMAIL=

# Invite-only sign-in for a closed trial (EXA-186): comma-separated addresses and @domain
# entries. Only a verified email on the list may sign in, with Google or GitHub (Microsoft is
# hidden while the list is set). Empty = open to all.
EXAM_ALLOWED_EMAILS=

# PDF exports: at most this many Chromium renders at once (each needs ~300 MB).
EXAM_EXPORT_CONCURRENCY=2
EXAM_EXPORT_TIMEOUT_MS=30000
